rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Fonction pour vérifier si l'utilisateur est connecté
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Fonction pour vérifier si l'utilisateur est admin
    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
    
    // Gestion des utilisateurs (accès restreint)
    match /users/{userId} {
      // Lecture de son propre profil ou par un admin
      allow read: if request.auth.uid == userId || isAdmin();
      
      // Création et mise à jour de son propre profil
      allow create, update: if request.auth.uid == userId || isAdmin();
      
      // Seul un admin peut supprimer un compte
      allow delete: if isAdmin();
    }
    
    // Règle spécifique pour les messages de contact (écriture publique)
    match /contacts/{contactId} {
      // Lecture pour les admins seulement
      allow read: if isAdmin();
      // Écriture publique pour permettre l'envoi de messages
      allow create: if true;
      // Seuls les admins peuvent modifier ou supprimer
      allow update, delete: if isAdmin();
    }
    
    // Règle générale pour toutes les autres collections
    match /{collection}/{document} {
      // Lecture publique pour toutes les collections
      allow read: if true;
      
      // Écriture pour les administrateurs
      allow write: if isAdmin();
    }
    
    // Règle spécifique pour les sélections d'événements (accès public en écriture)
    match /evenements/{eventId}/selections/{userId} {
      allow read: if true;
      // Permettre aux utilisateurs publics de créer/modifier leurs propres sélections
      allow create, update: if true;
      // Seuls les admins peuvent supprimer
      allow delete: if isAdmin();
    }
    
    // Règle pour les autres sous-collections
    match /{collection}/{document}/{subCollection}/{subDocument} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
} 