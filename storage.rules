rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Vérifier si l'utilisateur est connecté
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Vérifier si l'utilisateur est admin (requiert une vérification Firestore)
    function isAdmin() {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
    
    // Vérifier la taille et le type de fichier
    function isValidFile() {
      // Limite à 50MB
      return request.resource.size < 50 * 1024 * 1024 && 
        // Vérifier que le type de fichier est une image ou une vidéo
        (request.resource.contentType.matches('image/.*') || 
         request.resource.contentType.matches('video/.*'));
    }
    
    // Règles pour les médias
    match /media/{mediaFile} {
      // Lecture publique, écriture restreinte
      allow read: if true;
      allow write: if isAdmin() && isValidFile();
    }
    
    // Règles pour les photos
    match /photos/{photoFile} {
      allow read: if true;
      allow write: if isAdmin() && isValidFile();
    }
    
    // Règles pour les vidéos
    match /videos/{videoFile} {
      allow read: if true;
      allow write: if isAdmin() && isValidFile();
    }
    
    // Règles pour les logos
    match /logos/{logoFile} {
      allow read: if true;
      allow write: if isAdmin() && isValidFile();
    }
    
    // Règles par défaut pour tous les autres fichiers
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
} 